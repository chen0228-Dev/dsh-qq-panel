COMMON = [14, 1, 4, 12, 13, 20, 21, 22, 27, 32, 40, 49, 66, 85, 99,
          101, 105, 106, 111, 122, 124, 129, 179, 264, 271]

FACE_RE = re.compile(r"\[face:(\d{1,3})\]")


def default_target():
    for path in CONFIG_CANDIDATES:
        try:
            with open(path, encoding="utf-8") as f:
                qq = str((json.load(f).get("qq") or {}).get("adminQQ") or "")
            if qq:
                return qq
        except Exception:
            continue
    return ""


def call(action, params, timeout=25000):
    body = json.dumps({"action": action, "params": params, "timeout": timeout}).encode()
    req = urllib.request.Request(PANEL, data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout / 1000 + 8) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except Exception as e:
        qqcap.die(f"调用失败：{e}")


def build_segments(text):
    """把 "好啊[face:14]走起" 拆成 text / face / text 三段。"""
    segs = []
    last = 0
    for m in FACE_RE.finditer(text):
        if m.start() > last:
            segs.append({"type": "text", "data": {"text": text[last:m.start()]}})
        fid = m.group(1)
        segs.append({"type": "face", "data": {"id": fid}})
        last = m.end()
    if last < len(text):
        segs.append({"type": "text", "data": {"text": text[last:]}})
    return segs


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("what", nargs="*")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--to", default="")
    args = ap.parse_args()

    qqcap.need("face")

    if args.list:
        kw = " ".join(args.what)
        if kw:
            items = [(i, n) for i, n in sorted(FACES.items()) if kw in n]
        else:
            # 不筛就只给常用的，275 个全倒出来太占上下文
            items = [(i, FACES[i]) for i in COMMON if i in FACES]
            print(f"（全表共 {len(FACES)} 个，这里只列常用的；想看全部用 --list 关键词）")
        if not items:
            print(f"没有名字带「{kw}」的表情")
            return
        print(f"可用小黄脸共 {len(items)} 个（编号就是参数）：")
        row = []
        for i, n in items:
            row.append(f"{i:>3} {n}")
            if len(row) == 5:
                print("  " + "  ".join(row))
                row = []
        if row:
            print("  " + "  ".join(row))
        print("\n用法：qq-face 14   或者在文字里写 [face:14]")
        return

    raw = " ".join(args.what).strip()
    if not raw:
        qqcap.die("给我一个表情编号，或者 --list 看看有哪些")

    # 纯编号 = 只发表情
    if raw.isdigit():
        segs = [{"type": "face", "data": {"id": raw}}]
        label = f"表情 {raw}（{FACES.get(int(raw), '未知')}）"
    else:
        segs = build_segments(raw)
        if not any(s["type"] == "face" for s in segs):
            qqcap.die('文字里没有 [face:编号] 标记。纯文字消息不用这个命令，直接在回复里说就行。')
        label = "文字+表情"

    to = args.to or default_target()
    if not to:
        qqcap.die("不知道发给谁，加 --to QQ号")

    d = call("send_private_msg", {"user_id": int(to), "message": segs})
    if not d.get("ok"):
        qqcap.die(d.get("error") or "发送失败")
    mid = (d.get("data") or {}).get("message_id")
    print(f"已发送{label}" + (f"（message_id={mid}）" if mid else ""))


if __name__ == "__main__":
    main()
